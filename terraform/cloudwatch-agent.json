{
  "agent": {
    "region": "eu-north-1"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/phishing-setup.log",
            "log_group_name": "/phishing-detector/setup",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/var/log/phishing-error.log",
            "log_group_name": "/phishing-detector/app-errors",
            "log_stream_name": "{instance_id}"
          }
        ]
      }
    }
  }
}
